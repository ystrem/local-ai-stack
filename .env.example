# local-ai-stack — per-machine environment template
# Copy to .env and customize for your machine

# ── Stroj identifikace ───────────────────────────────────
MACHINE_ID=aiworker   # aicore | aiworker | desktop | codebox

# ── GPU architektura (auto-detekované install.sh) ────────
GPU_ARCH=120          # 61=P40, 86=Ampere, 120=Blackwell, 1030=ROCm
GGML_CUDA_ARCH=120
CUDA_DEVICE=auto
GPU_DEVICE_ID=0
MOSS_MULTI_GPU=0      # 1 = multi-GPU MOSS-TTS split (jen aiworker)

# ── Modely (NFS mount) ────────────────────────────────────
MODEL_DIR=/mnt/models
QWEN_MODEL=/models/llama/Qwen3.8-27B-NVFP4-MTP-GGUF/Qwen3.8-27B-NVFP4-MTP-COMPACT-LOW.gguf
QWEN_PORT=8085
CTX_SIZE=16384
CACHE_TYPE_V=q4_0

# ── ComfyUI build args (per-machine optimalizace) ──────────
CUDA_BASE=nvidia/cuda:13.0.3-runtime-ubuntu24.04
TORCH_VERSION=2.11.0
TORCH_VISION=0.26.0
TORCH_AUDIO=2.11.0
TORCH_INDEX=cu130
COMFYUI_EXTRA_ARGS=--use-pytorch-cross-attention --fast --bf16-unet --highvram

# ── Hub-UI konfigurace ────────────────────────────────────
HUB_PROBE_INTERVAL=5
HUB_GENERATE_TIMEOUT=600
CLUSTER_MODE=manual   # manual | auto

# ── Stroje v clusteru (Hub-UI discovery) ─────────────────
# Edituj po `git clone` — tyto IP adresy se expandují do WebUI URLs
AICORE_HOST=192.168.10.60
AIWORKER_HOST=192.168.10.194
DESKTOP_HOST=192.168.10.228
